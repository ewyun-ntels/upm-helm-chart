      "targets": [
        {
          "expr": "max(kube_node_status_condition{node=\"$node\", condition=\"Ready\", status=\"true\"})",
          "instant": true,
          "legendFormat": "Ready",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [
            {
