    {
      "id": 3,
      "type": "status-history",
      "title": "Node Pod Map - $node",
      "description": "선택한 노드 안에 떠 있는 Pod를 행으로 표시하고 phase를 색상으로 구분합니다.",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max by (namespace, pod) (((kube_pod_status_phase{namespace=~\"$namespace\", phase=\"Running\"} == 1) * 1 or (kube_pod_status_phase{namespace=~\"$namespace\", phase=\"Pending\"} == 1) * 2 or (kube_pod_status_phase{namespace=~\"$namespace\", phase=\"Succeeded\"} == 1) * 3 or (kube_pod_status_phase{namespace=~\"$namespace\", phase=\"Failed\"} == 1) * 4 or (kube_pod_status_phase{namespace=~\"$namespace\", phase=\"Unknown\"} == 1) * 5) * on(namespace, pod) group_left(node) kube_pod_info{node=\"$node\", namespace=~\"$namespace\"})",
          "legendFormat": "{{namespace}}/{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Running",
                  "color": "green"
                },
                "2": {
                  "text": "Pending",
                  "color": "yellow"
                },
                "3": {
                  "text": "Succeeded",
                  "color": "blue"
                },
                "4": {
                  "text": "Failed",
                  "color": "red"
                },
                "5": {
                  "text": "Unknown",
                  "color": "purple"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "blue",
                "value": 3
              },
              {
                "color": "red",
                "value": 4
              },
              {
                "color": "purple",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.85,
        "colWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Pods on Selected Node",
      "description": "선택한 노드에 스케줄링된 Pod 목록과 현재 phase를 표시합니다.",
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max by (namespace, pod, node, phase, pod_ip, host_ip, created_by_kind, created_by_name) ((kube_pod_status_phase{namespace=~\"$namespace\"} == 1) * on(namespace, pod) group_left(node, pod_ip, host_ip, created_by_kind, created_by_name) kube_pod_info{node=\"$node\", namespace=~\"$namespace\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "phase"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Running": {
                        "text": "Running",
                        "color": "green"
                      },
                      "Pending": {
                        "text": "Pending",
                        "color": "yellow"
                      },
                      "Succeeded": {
                        "text": "Succeeded",
                        "color": "blue"
                      },
                      "Failed": {
                        "text": "Failed",
                        "color": "red"
                      },
                      "Unknown": {
                        "text": "Unknown",
                        "color": "purple"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "count"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "phase": 2,
              "node": 3,
              "pod_ip": 4,
              "host_ip": 5,
              "created_by_kind": 6,
              "created_by_name": 7
            },
            "renameByName": {
              "namespace": "Namespace",
              "pod": "Pod",
              "phase": "Phase",
              "node": "Node",
              "pod_ip": "Pod IP",
              "host_ip": "Host IP",
              "created_by_kind": "Owner Kind",
              "created_by_name": "Owner Name"
            }
          }
        }
      ]
    }
  ]
}
