      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Inbound Outcomes Total 2m Trend",
      "description": "recording-rule \uc785\ub825 \uc9c0\ud45c. \ucd5c\uadfc 2\ubd84 \uae30\uc900 inbound \uc644\ub8cc \uc694\uccad \uc218 \ucd94\uc774.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "tcp_bridge:inbound_outcomes_total:increase2m{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"}",
          "legendFormat": "{{sys_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70
          }
        }
