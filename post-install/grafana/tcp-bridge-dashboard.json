    {
      "id": 11,
      "type": "timeseries",
      "title": "Inbound Request And Response Rate By Reason",
      "description": "\uc6d0\uc2dc \uce74\uc6b4\ud130 \uae30\ubc18 \ucc98\ub9ac\ub7c9. reason\ubcc4 \uc751\ub2f5 \ubd84\ud3ec \ud655\uc778. ok=\uc815\uc0c1, queue_full=queue\ud3ec\ud654, unknown_message_type=subject\ub9e4\ud551\uc2e4\ud328, nats_request_timeout/failed=NATS\uc624\ub958, tcp_response_write_failed=TCP\uc751\ub2f5\uc2e4\ud328, inflight_expired=timeout.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (sys_id) (label_replace(sum by (pod) (increase(tcp_bridge_inbound_requests_total{job=~\"$job\", pod=~\"$pod\"}[$__rate_interval])), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\"))",
          "legendFormat": "{{sys_id}} [REQ]",
          "refId": "A"
        },
        {
          "expr": "sum by (sys_id, reason) (label_replace(sum by (pod, reason) (increase(tcp_bridge_inbound_responses_total{job=~\"$job\", pod=~\"$pod\", reason!=\"\"}[$__rate_interval])), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\"))",
          "legendFormat": "{{sys_id}} [RSP] {{reason}}",
          "refId": "B"
        },
        {
          "expr": "sum by (sys_id) (label_replace(sum by (pod) (increase(tcp_bridge_inbound_responses_total{job=~\"$job\", pod=~\"$pod\", reason=\"\"}[$__rate_interval])), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\"))",
          "legendFormat": "{{sys_id}} [RSP] unknown",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        }
      }
    },
