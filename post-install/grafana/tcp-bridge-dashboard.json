{
  "title": "TCP Bridge Monitoring",
  "uid": "tcp-bridge-overview",
  "tags": [
    "tcp-bridge",
    "outcomes-total",
    "responses-sent",
    "recording-rules"
  ],
  "schemaVersion": 38,
  "version": 8,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "thanos-query",
          "value": "thanos-query",
          "selected": true
        },
        "hide": 2,
        "regex": "thanos-query"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tcp_bridge:ready_connection_state:max, job)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tcp_bridge:ready_connection_state:max{job=~\"$job\"}, pod)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0
      },
      {
        "name": "sys_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\"}, sys_id)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 6,
      "type": "timeseries",
      "title": "Inbound Completion And Response Sent Rate",
      "description": "\ucd5c\uadfc 2\ubd84 \ub3d9\uc548 \uc99d\uac00\ud55c inbound requests_total \ub300\ube44 outcomes_total \ube44\uc728\uacfc inbound_responses_sent_total \ube44\uc728\uc744 \uac01\uac01 \ud45c\uc2dc. \ucd5c\uc885 \ucc98\ub9ac \uc644\ub8cc\uc728\uacfc \uc678\ubd80 TCP \uc751\ub2f5 \uc1a1\uc2e0\uc728\uc744 \ubd84\ub9ac\ud574 \ucd94\uc774\ub97c \ud655\uc778.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "((sum by (sys_id) (label_replace(increase(tcp_bridge_inbound_outcomes_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\"))) / clamp_min(sum by (sys_id) (label_replace(increase(tcp_bridge_inbound_requests_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\")), 1)) and on (sys_id) max by (sys_id) (tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"})",
          "legendFormat": "{{sys_id}} outcome completion",
          "refId": "A"
        },
        {
          "expr": "((sum by (sys_id) (label_replace(increase(tcp_bridge_inbound_responses_sent_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\"))) / clamp_min(sum by (sys_id) (label_replace(increase(tcp_bridge_inbound_requests_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\")), 1)) and on (sys_id) max by (sys_id) (tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"})",
          "legendFormat": "{{sys_id}} response sent",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*response sent"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.95
                    },
                    {
                      "color": "green",
                      "value": 0.99
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*outcome completion"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.95
                    },
                    {
                      "color": "green",
                      "value": 0.99
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Outbound Completion And Response Sent Rate",
      "description": "\ucd5c\uadfc 2\ubd84 \ub3d9\uc548 \uc99d\uac00\ud55c outbound requests_total \ub300\ube44 outcomes_total \ube44\uc728\uacfc outbound_responses_sent_total \ube44\uc728\uc744 \uac01\uac01 \ud45c\uc2dc. \ucd5c\uc885 \ucc98\ub9ac \uc644\ub8cc\uc728\uacfc NATS reply \uc1a1\uc2e0\uc728\uc744 \ubd84\ub9ac\ud574 \ucd94\uc774\ub97c \ud655\uc778.",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "((sum by (sys_id) (label_replace(increase(tcp_bridge_outbound_outcomes_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\"))) / clamp_min(sum by (sys_id) (label_replace(increase(tcp_bridge_outbound_requests_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\")), 1)) and on (sys_id) max by (sys_id) (tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"})",
          "legendFormat": "{{sys_id}} outcome completion",
          "refId": "A"
        },
        {
          "expr": "((sum by (sys_id) (label_replace(increase(tcp_bridge_outbound_responses_sent_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\"))) / clamp_min(sum by (sys_id) (label_replace(increase(tcp_bridge_outbound_requests_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\")), 1)) and on (sys_id) max by (sys_id) (tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"})",
          "legendFormat": "{{sys_id}} response sent",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*response sent"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.95
                    },
                    {
                      "color": "green",
                      "value": 0.99
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*outcome completion"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.95
                    },
                    {
                      "color": "green",
                      "value": 0.99
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Traffic Detail",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Inbound Outcomes By Msg Type And Reason",
      "description": "\ucd5c\uadfc $__rate_interval \ub3d9\uc548 \uc99d\uac00\ud55c inbound outcomes_total\uc744 msg_type, reason\ubcc4\ub85c \ud569\uc0b0\ud574 \ud45c\uc2dc.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (sys_id, msg_type, reason) (label_replace(increase(tcp_bridge_inbound_outcomes_total{job=~\"$job\", pod=~\"$pod\"}[$__rate_interval]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\")) and on (sys_id) max by (sys_id) (tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"})",
          "legendFormat": "{{sys_id}} / {{msg_type}} / {{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 70
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Outbound Outcomes By Msg Type And Reason",
      "description": "\ucd5c\uadfc $__rate_interval \ub3d9\uc548 \uc99d\uac00\ud55c outbound outcomes_total\uc744 msg_type, reason\ubcc4\ub85c \ud569\uc0b0\ud574 \ud45c\uc2dc.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum by (sys_id, msg_type, reason) (label_replace(increase(tcp_bridge_outbound_outcomes_total{job=~\"$job\", pod=~\"$pod\"}[$__rate_interval]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\")) and on (sys_id) max by (sys_id) (tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"})",
          "legendFormat": "{{sys_id}} / {{msg_type}} / {{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 70
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Connectivity",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Ready Connection State",
      "description": "\ud604\uc7ac connection \uc0c1\ud0dc\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4. 2\ub294 Ready, 1\uc740 Connecting, 0\uc740 Disconnected\ub97c \uc758\ubbf8\ud569\ub2c8\ub2e4.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max by (pod_group, connection_id) (label_replace(tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"}, \"pod_group\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\"))",
          "legendFormat": "{{pod_group}} / {{connection_id}}",
          "refId": "A"
        }
      ],
      "instant": true,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disconnected",
                  "color": "red"
                },
                "1": {
                  "text": "Connecting",
                  "color": "yellow"
                },
                "2": {
                  "text": "Ready",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Active Primary Connection",
      "description": "\ud604\uc7ac \uc120\ud0dd\ub41c primary connection. outbound \uc804\uc1a1\uc5d0 \uc0ac\uc6a9\ub418\ub294 active connection \ud45c\uc2dc.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 16,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max by (pod_group, connection_id) (label_replace((tcp_bridge_selected_connection{job=~\"$job\", pod=~\"$pod\"} == 1) and on (job, namespace, pod, connection_id) (tcp_bridge_connection_state{job=~\"$job\", pod=~\"$pod\"} > 0), \"pod_group\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\"))",
          "legendFormat": "{{pod_group}} / {{connection_id}}",
          "refId": "A"
        }
      ],
      "instant": true,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "name"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "green",
            "mode": "fixed"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Active"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "Latency",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Inbound End-to-End Duration",
      "description": "Histogram \uae30\ubc18 inbound end-to-end latency. \uc694\uccad \uc218\uc2e0\ubd80\ud130 \ucd5c\uc885 TCP \uc751\ub2f5 \ucc98\ub9ac\uae4c\uc9c0\uc758 p50/p95.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "label_replace(histogram_quantile(0.50, sum by (le, pod, connection_id) (rate(tcp_bridge_inbound_end_to_end_duration_seconds_bucket{job=~\"$job\", pod=~\"$pod\"}[$__rate_interval]))), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\")",
          "legendFormat": "{{sys_id}} / {{connection_id}} p50",
          "refId": "A"
        },
        {
          "expr": "label_replace(histogram_quantile(0.95, sum by (le, pod, connection_id) (rate(tcp_bridge_inbound_end_to_end_duration_seconds_bucket{job=~\"$job\", pod=~\"$pod\"}[$__rate_interval]))), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\")",
          "legendFormat": "{{sys_id}} / {{connection_id}} p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 70
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Outbound End-to-End Duration",
      "description": "Histogram \uae30\ubc18 outbound end-to-end latency. \uc694\uccad \uc218\uc2e0\ubd80\ud130 \ucd5c\uc885 NATS reply \ubc1c\ud589\uae4c\uc9c0\uc758 p50/p95.",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "label_replace(histogram_quantile(0.50, sum by (le, pod, connection_id) (rate(tcp_bridge_outbound_end_to_end_duration_seconds_bucket{job=~\"$job\", pod=~\"$pod\"}[$__rate_interval]))), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\")",
          "legendFormat": "{{sys_id}} / {{connection_id}} p50",
          "refId": "A"
        },
        {
          "expr": "label_replace(histogram_quantile(0.95, sum by (le, pod, connection_id) (rate(tcp_bridge_outbound_end_to_end_duration_seconds_bucket{job=~\"$job\", pod=~\"$pod\"}[$__rate_interval]))), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\")",
          "legendFormat": "{{sys_id}} / {{connection_id}} p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 70
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "Aggregated By Service (All Pods)",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Inbound Completion And Response Sent Rate (Total)",
      "description": "\uc804\uccb4 tcp-bridge pod\ub4e4\uc758 \ud569\uc0b0 - \ucd5c\uadfc 2\ubd84 \ub3d9\uc548 \uc99d\uac00\ud55c inbound requests_total \ub300\ube44 outcomes_total \ube44\uc728\uacfc inbound_responses_sent_total \ube44\uc728\uc744 \uac01\uac01 \ud45c\uc2dc.",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "(sum(increase(tcp_bridge_inbound_outcomes_total{job=~\"$job\", pod=~\"$pod\"}[2m]))) / clamp_min(sum(increase(tcp_bridge_inbound_requests_total{job=~\"$job\", pod=~\"$pod\"}[2m])), 1)",
          "legendFormat": "tcp-bridge outcome completion",
          "refId": "A"
        },
        {
          "expr": "(sum(increase(tcp_bridge_inbound_responses_sent_total{job=~\"$job\", pod=~\"$pod\"}[2m]))) / clamp_min(sum(increase(tcp_bridge_inbound_requests_total{job=~\"$job\", pod=~\"$pod\"}[2m])), 1)",
          "legendFormat": "tcp-bridge response sent",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*response sent"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.95
                    },
                    {
                      "color": "green",
                      "value": 0.99
                    }
                  ]
                }
              }
            ]
          },
          {
