{
  "title": "TCP Bridge Monitoring",
  "uid": "tcp-bridge-overview",
  "tags": [
    "tcp-bridge",
    "traffic-quality",
    "recording-rules"
  ],
  "schemaVersion": 38,
  "version": 7,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "thanos-query",
          "value": "thanos-query",
          "selected": true
        },
        "hide": 2,
        "regex": "thanos-query"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tcp_bridge:ready_connection_state:max, job)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tcp_bridge:ready_connection_state:max{job=~\"$job\"}, pod)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0
      },
      {
        "name": "sys_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\"}, sys_id)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Rule Based Overview",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Inbound Communication Rate 2m",
      "description": "recording-rule \uae30\uc900 \ud604\uc7ac inbound \uc131\uacf5 \uc751\ub2f5 \ube44\uc728. 95% \uc774\uc0c1 \uc815\uc0c1.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "tcp_bridge:inbound_communication_rate:2m{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"}",
          "legendFormat": "{{sys_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "bargauge",
