{
  "title": "TCP Bridge Monitoring",
  "uid": "tcp-bridge-overview",
  "tags": [
    "tcp-bridge",
    "outcomes-total",
    "responses-sent",
    "recording-rules"
  ],
  "schemaVersion": 38,
  "version": 8,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "thanos-query",
          "value": "thanos-query",
          "selected": true
        },
        "hide": 2,
        "regex": "thanos-query"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tcp_bridge:ready_connection_state:max, job)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tcp_bridge:ready_connection_state:max{job=~\"$job\"}, pod)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0
      },
      {
        "name": "sys_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\"}, sys_id)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Rule Based Overview",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Inbound Error Ratio 2m",
      "description": "recording-rule \uae30\uc900 \ud604\uc7ac inbound \uc644\ub8cc \uc694\uccad \uc911 \uc2e4\ud328 \ube44\uc728. alert \uc784\uacc4\uac12\uc740 10% \uc774\uc0c1.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "tcp_bridge:inbound_error_ratio:2m{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"}",
          "legendFormat": "{{sys_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Inbound Outcomes Total 2m",
      "description": "recording-rule \uae30\uc900 \ucd5c\uadfc 2\ubd84 \ub3d9\uc548 \uc644\ub8cc\ub41c inbound \uc694\uccad \uc218. alert \ud45c\ubcf8 \uc218 \uc870\uac74\uc740 5\uac74 \uc774\uc0c1.",
      "gridPos": {
        "x": 6,
        "y": 7,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "tcp_bridge:inbound_outcomes_total:increase2m{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"}",
          "legendFormat": "{{sys_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 10,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Outbound Error Ratio 2m",
      "description": "recording-rule \uae30\uc900 \ud604\uc7ac outbound \uc644\ub8cc \uc694\uccad \uc911 \uc2e4\ud328 \ube44\uc728. alert \uc784\uacc4\uac12\uc740 10% \uc774\uc0c1.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "tcp_bridge:outbound_error_ratio:2m{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"}",
          "legendFormat": "{{sys_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Outbound Outcomes Total 2m",
      "description": "recording-rule \uae30\uc900 \ucd5c\uadfc 2\ubd84 \ub3d9\uc548 \uc644\ub8cc\ub41c outbound \uc694\uccad \uc218. alert \ud45c\ubcf8 \uc218 \uc870\uac74\uc740 5\uac74 \uc774\uc0c1.",
      "gridPos": {
        "x": 18,
        "y": 7,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "tcp_bridge:outbound_outcomes_total:increase2m{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"}",
          "legendFormat": "{{sys_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 10,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Inbound Completion And Response Sent Rate",
      "description": "README \uae30\uc900 `requests_total` \ub300\ube44 `outcomes_total`, `responses_sent_total` \ube44\uc728\uc744 \ubd84\ub9ac\ud574 \ucd94\uc774 \ud655\uc778.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "((sum by (sys_id) (label_replace(increase(tcp_bridge_inbound_outcomes_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\"))) / clamp_min(sum by (sys_id) (label_replace(increase(tcp_bridge_inbound_requests_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\")), 1)) and on (sys_id) max by (sys_id) (tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"})",
          "legendFormat": "{{sys_id}} outcome completion",
          "refId": "A"
        },
        {
          "expr": "((sum by (sys_id) (label_replace(increase(tcp_bridge_inbound_responses_sent_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\"))) / clamp_min(sum by (sys_id) (label_replace(increase(tcp_bridge_inbound_requests_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\")), 1)) and on (sys_id) max by (sys_id) (tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"})",
          "legendFormat": "{{sys_id}} response sent",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*response sent"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.95
                    },
                    {
                      "color": "green",
                      "value": 0.99
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*outcome completion"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.95
                    },
                    {
                      "color": "green",
                      "value": 0.99
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Outbound Completion And Response Sent Rate",
      "description": "README \uae30\uc900 `requests_total` \ub300\ube44 `outcomes_total`, `responses_sent_total` \ube44\uc728\uc744 \ubd84\ub9ac\ud574 \ucd94\uc774 \ud655\uc778.",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "((sum by (sys_id) (label_replace(increase(tcp_bridge_outbound_outcomes_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\"))) / clamp_min(sum by (sys_id) (label_replace(increase(tcp_bridge_outbound_requests_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\")), 1)) and on (sys_id) max by (sys_id) (tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"})",
          "legendFormat": "{{sys_id}} outcome completion",
          "refId": "A"
        },
        {
          "expr": "((sum by (sys_id) (label_replace(increase(tcp_bridge_outbound_responses_sent_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\"))) / clamp_min(sum by (sys_id) (label_replace(increase(tcp_bridge_outbound_requests_total{job=~\"$job\", pod=~\"$pod\"}[2m]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\")), 1)) and on (sys_id) max by (sys_id) (tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"})",
          "legendFormat": "{{sys_id}} response sent",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*response sent"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.95
                    },
                    {
                      "color": "green",
                      "value": 0.99
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*outcome completion"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.95
                    },
                    {
                      "color": "green",
                      "value": 0.99
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Traffic Detail",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Inbound Request Outcome And Response Sent Count",
      "description": "README \uae30\uc900 요청 진입량, 최종 처리 완료량(outcome), 외부 TCP 응답 송신 성공량(response sent)을 분리해 확인.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(increase(tcp_bridge_inbound_requests_total{job=~\"$job\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "[REQ]",
          "refId": "A"
        },
        {
          "expr": "sum(increase(tcp_bridge_inbound_outcomes_total{job=~\"$job\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "[OUT]",
          "refId": "B"
        },
        {
          "expr": "sum(increase(tcp_bridge_inbound_responses_sent_total{job=~\"$job\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "[RESP SENT]",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Outbound Request Outcome And Response Sent Count",
      "description": "README \uae30\uc900 요청 진입량, 최종 처리 완료량(outcome), NATS reply 송신 성공량(response sent)을 분리해 확인.",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(increase(tcp_bridge_outbound_requests_total{job=~\"$job\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "[REQ]",
