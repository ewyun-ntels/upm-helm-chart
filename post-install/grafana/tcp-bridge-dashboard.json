    {
      "id": 20,
      "type": "row",
      "title": "연결 상태",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 21,
      "type": "stat",
      "title": "연결상태",
      "description": "\ud604\uc7ac connection \uc0c1\ud0dc\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4. 2\ub294 Ready, 1\uc740 Connecting, 0\uc740 Disconnected\ub97c \uc758\ubbf8\ud569\ub2c8\ub2e4.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max by (pod_group, connection_name) (label_replace(tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"}, \"pod_group\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\"))",
          "legendFormat": "{{pod_group}} / {{connection_name}}",
          "refId": "A"
        }
      ],
      "instant": true,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disconnected",
                  "color": "red"
                },
                "1": {
                  "text": "Connecting",
                  "color": "yellow"
                },
                "2": {
                  "text": "Ready",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Outbound Primary 연결",
      "description": "\ud604\uc7ac \uc120\ud0dd\ub41c primary connection. outbound \uc804\uc1a1\uc5d0 \uc0ac\uc6a9\ub418\ub294 active connection \ud45c\uc2dc.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 16,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "max by (pod_group, connection_name) (label_replace(tcp_bridge_selected_connection{job=~\"$job\", pod=~\"$pod\"} == 1, \"pod_group\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\"))",
          "legendFormat": "{{pod_group}} / {{connection_name}}",
          "refId": "A"
        },
        {
          "expr": "max by (connection_name) (tcp_bridge_selected_connection{job=~\"$job\", pod=~\"$pod\"}) == 0",
          "legendFormat": "{{connection_name}}",
          "refId": "B"
        }
      ],
      "instant": true,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "name"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disconnected"
                },
                "1": {
                  "text": "Active"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "지연 시간",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "연결별 Inbound 종단간 지연시간",
      "description": "Histogram \uae30\ubc18 inbound end-to-end latency. connection_name\ubcc4 p95\ub97c \uc911\uc2ec\uc73c\ub85c \ubcf4\uace0 p50\ub294 \ube44\uad50\uc6a9\uc73c\ub85c \ud655\uc778.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, connection_name) ((label_replace(rate(tcp_bridge_inbound_end_to_end_duration_seconds_bucket{job=~\"$job\", pod=~\"$pod\"}[$__rate_interval]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\") ) and on (sys_id, connection_name) max by (sys_id, connection_name) (tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"})))",
          "legendFormat": "{{connection_name}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, connection_name) ((label_replace(rate(tcp_bridge_inbound_end_to_end_duration_seconds_bucket{job=~\"$job\", pod=~\"$pod\"}[$__rate_interval]), \"sys_id\", \"$1\", \"pod\", \".*(tcp-bridge-[0-9]+).*\") ) and on (sys_id, connection_name) max by (sys_id, connection_name) (tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"})))",
          "legendFormat": "{{connection_name}} p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "pointSize": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* p50"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* p95"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        }
      }
    },
