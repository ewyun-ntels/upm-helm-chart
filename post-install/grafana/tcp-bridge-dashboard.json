{
  "title": "TCP Bridge Monitoring",
  "uid": "tcp-bridge-overview",
  "tags": [
    "tcp-bridge",
    "outcomes-total",
    "responses-sent",
    "recording-rules"
  ],
  "schemaVersion": 38,
  "version": 8,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "thanos-query",
          "value": "thanos-query",
          "selected": true
        },
        "hide": 2,
        "regex": "thanos-query"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tcp_bridge:ready_connection_state:max, job)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tcp_bridge:ready_connection_state:max{job=~\"$job\"}, pod)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0
      },
      {
        "name": "sys_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(tcp_bridge:ready_connection_state:max{job=~\"$job\", pod=~\"$pod\"}, sys_id)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Rule Based Overview",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Inbound Error Ratio 2m",
      "description": "\ucd5c\uadfc 2\ubd84 \ub3d9\uc548 \ucc98\ub9ac\ub41c inbound outcome \uc911 \uc2e4\ud328(error, timeout, dropped) \ube44\uc728\uc785\ub2c8\ub2e4. \uc644\ub8cc \uac74\uc218\uac00 5\uac74 \uc774\uc0c1\uc77c \ub54c 10% \uc774\uc0c1 \uc0c1\ud0dc\uac00 1\ubd84 \uc774\uc0c1 \uc9c0\uc18d\ub418\uba74 alert\uac00 \ubc1c\uc0dd\ud569\ub2c8\ub2e4.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "tcp_bridge:inbound_error_ratio:2m{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"}",
          "legendFormat": "{{sys_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Inbound Outcomes Total 2m",
      "description": "\ucd5c\uadfc 2\ubd84 \ub3d9\uc548 \uc9d1\uacc4\ub41c inbound outcome \ucd1d\uac74\uc218\uc785\ub2c8\ub2e4. inbound error ratio\ub97c \ud310\ub2e8\ud558\ub294 \ud45c\ubcf8 \uc218\ub85c \uc0ac\uc6a9\ub418\uba70, 5\uac74 \uc774\uc0c1\uc77c \ub54c alert \uc870\uac74\uc744 \ubcf4\ub294 \uae30\uc900\uc774 \ub429\ub2c8\ub2e4.",
      "gridPos": {
        "x": 6,
        "y": 7,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "tcp_bridge:inbound_outcomes_total:increase2m{job=~\"$job\", pod=~\"$pod\", sys_id=~\"$sys_id\"}",
          "legendFormat": "{{sys_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 10,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          }
        }
      }
    },
