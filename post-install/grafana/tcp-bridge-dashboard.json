{
  "title": "TCP Bridge",
  "uid": "tcp-bridge-overview",
  "tags": ["tcp-bridge"],
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "thanos-query",
          "value": "thanos-query",
          "selected": true
        },
        "hide": 2,
        "regex": "thanos-query"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(tcp_bridge_connection_state, job)", "refId": "A" },
        "refresh": 2,
        "hide": 0
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(tcp_bridge_connection_state{job=\"$job\"}, pod)", "refId": "A" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Connection Status",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Connection State",
      "description": "2=Ready, 1=Connecting, 0=Disconnected",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "tcp_bridge_connection_state{job=\"$job\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}} / {{connection_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Disconnected", "color": "red" }, "1": { "text": "Connecting", "color": "yellow" }, "2": { "text": "Ready", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [] }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Connection",
      "description": "현재 primary/master로 선택된 connection (1=selected, 0=not selected)",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "tcp_bridge_selected_connection{job=\"$job\", pod=~\"$pod\"} == 1",
          "legendFormat": "{{pod}} / {{connection_id}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "mappings": [ { "type": "value", "options": { "1": { "text": "Selected" } } } ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failover 발생",
      "description": "선택된 connection 변경 총 횟수 (reason: selected, failover, higher_priority_restored, connection_lost, active_changed). 짧은 시간 반복 증가 시 active 회선 flap 가능성 확인 필요",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "increase(tcp_bridge_failover_total{job=\"$job\", pod=~\"$pod\"}[$__range])",
          "legendFormat": "{{pod}} {{reason}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connection State Over Time",
      "description": "각 TCP 연결의 상태 변화 추이 (0=disconnected, 1=connecting, 2=ready). selected_connection과 함께 보면 primary/standby 회선 구분 가능",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "tcp_bridge_connection_state{job=\"$job\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}} / {{connection_id}} ({{exported_endpoint}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { 
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ping RTT",
      "description": "keep-alive PING 전송 후 PONG 응답까지의 round-trip time (p50/p95/p99)",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(tcp_bridge_ping_rtt_seconds_bucket{job=\"$job\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} / {{connection_id}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(tcp_bridge_ping_rtt_seconds_bucket{job=\"$job\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} / {{connection_id}} p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(tcp_bridge_ping_rtt_seconds_bucket{job=\"$job\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} / {{connection_id}} p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Connection Events Rate",
      "description": "연결 이벤트 발생률 - attempts: dial 시도, success: READY 진입, failures: 연결/handshake 실패, disconnects: 연결 끊김. attempts-success 차이가 계속 커지면 연결 불안정",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(tcp_bridge_connection_attempts_total{job=\"$job\", pod=~\"$pod\"}[$__rate_interval])",
          "legendFormat": "{{pod}} / {{connection_id}} attempts",
          "refId": "A"
        },
        {
          "expr": "rate(tcp_bridge_connection_success_total{job=\"$job\", pod=~\"$pod\"}[$__rate_interval])",
          "legendFormat": "{{pod}} / {{connection_id}} success",
          "refId": "B"
        },
        {
          "expr": "rate(tcp_bridge_connection_failures_total{job=\"$job\", pod=~\"$pod\"}[$__rate_interval])",
          "legendFormat": "{{pod}} / {{connection_id}} / {{reason}} failure",
          "refId": "C"
        },
        {
          "expr": "rate(tcp_bridge_disconnects_total{job=\"$job\", pod=~\"$pod\"}[$__rate_interval])",
          "legendFormat": "{{pod}} / {{connection_id}} / {{reason}} disconnect",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Send Queue",
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "gauge",
      "title": "Send Queue Utilization",
      "description": "송신 큐 사용률 (%). 80% 이상 시 큐 크기 조정 검토 필요",
      "gridPos": { "x": 0, "y": 22, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "tcp_bridge_send_queue_utilization_percent{job=\"$job\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Send Queue Size",
      "description": "현재 송신 큐에 대기 중인 메시지 수",
      "gridPos": { "x": 6, "y": 22, "w": 9, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "tcp_bridge_send_queue_size{job=\"$job\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Send Queue Operations",
      "description": "송신 큐 작업 처리율 - enqueue: 큐 추가, drop: 큐 포화로 인한 드롭. drop 발생 시 큐 크기 및 처리 성능 확인 필요",
      "gridPos": { "x": 15, "y": 22, "w": 9, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(tcp_bridge_send_queue_enqueue_total{job=\"$job\", pod=~\"$pod\"}[$__rate_interval])",
          "legendFormat": "{{pod}} enqueue",
          "refId": "A"
        },
        {
          "expr": "rate(tcp_bridge_send_queue_drop_total{job=\"$job\", pod=~\"$pod\"}[$__rate_interval])",
          "legendFormat": "{{pod}} drop",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" }
      }
    }
  ]
}
